# ==============================================================================
# TrustBroker AI — React TypeScript Frontend Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' inside the 'react_app/' directory:
#   cp .env.example .env
#
# Vite requires environment variables exposed to client-side code to be prefixed
# with 'VITE_'. Do NOT place private backend secrets or private keys here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Developer Platform (Sandbox Mode)
# ------------------------------------------------------------------------------
# Get your Sandbox Client ID from: https://developer.paypal.com/dashboard/applications/sandbox
# Under "Apps & Credentials", select your app and copy the "Client ID".
VITE_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-here

# Default currency for PayPal staging and staged funds transactions (e.g. USD, EUR, GBP)
VITE_PAYPAL_CURRENCY=USD

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & Database (Free Tier)
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
# 1) Project URL:
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# 2) Project Public Anon Key (safe for frontend client-side use):
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 3. Backend Service API URL (FastAPI)
# ------------------------------------------------------------------------------
# Local Development: http://localhost:8000/api/v1
# Production (Render): https://trustbroker-ai-api-bx9a.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Allow offline dev auth tokens (strictly disabled in production, false by default)
VITE_ALLOW_DEV_AUTH=false

# ------------------------------------------------------------------------------
# 4. AG Studio & AG Grid Licenses (Optional — app functions without them)
# ------------------------------------------------------------------------------
# An AG Studio licence covers AG Studio and its built-in widgets.
# Standalone AG Grid ledgers run watermark-free on Community edition.
# 45-day AG Studio trial: https://www.ag-grid.com/studio/react/enterprise-licence/
VITE_AG_STUDIO_LICENSE_KEY=

# Standalone AG Grid Enterprise license (optional; leave blank to use Community):
# VITE_AG_GRID_LICENSE_KEY=
