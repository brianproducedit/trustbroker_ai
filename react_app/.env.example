# ==============================================================================
# TrustBroker AI — React TypeScript Frontend Environment Configuration
# ==============================================================================
# Copy this file to '.env' in the same directory:
#   cp .env.example .env
#
# Vite requires environment variables exposed to client-side code to be prefixed
# with 'VITE_'. Do NOT place private backend secrets or private keys here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Developer Platform (Sandbox Mode)
# ------------------------------------------------------------------------------
# Get your Sandbox Client ID from: https://developer.paypal.com/dashboard/applications/sandbox
# Under "Apps & Credentials", select your app and copy the "Client ID".
# Example: BAAmI_hm2hcLqXaEfmcdS2nqtnkLq1lbmEiObYFaZ6uSbZqvn3uMVeHPVtoTJAheKH8ZCR1duXTaypmcLY
VITE_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-here

# Default currency for PayPal staging and escrow transactions (e.g. USD, EUR, GBP)
VITE_PAYPAL_CURRENCY=USD

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & Database (Free Tier)
# ------------------------------------------------------------------------------
# Create a free project at: https://supabase.com/dashboard
# Navigate to: Project Settings -> API
# 
# 1) Project URL:
#    Example: https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# 2) Project Public Anon Key (safe for frontend use):
#    Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 3. Backend Service API URL (FastAPI)
# ------------------------------------------------------------------------------
# Local Development: http://localhost:8000/api/v1
# Production (Render): https://trustbroker-ai-api-bx9a.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 4. AG Studio / AG Grid Licences (optional — the app works without them)
# ------------------------------------------------------------------------------
# An AG Studio licence covers AG Studio and its built-in widgets ONLY. It does
# NOT licence standalone AG Grid Enterprise used by the ledger grids.
# Without any key: AG Grid Community (free, no watermark) + AG Studio watermark.
#
# 45-day AG Studio trial: https://www.ag-grid.com/studio/react/enterprise-licence/
VITE_AG_STUDIO_LICENSE_KEY=

# Separate AG Grid Enterprise licence (only if you have one). Leave blank to use Community.
# VITE_AG_GRID_LICENSE_KEY=

