# ==============================================================================
# TrustBroker AI — Master Full-Stack Environment Configuration Template
# ==============================================================================
# This file lists all environment variables required across both the React Frontend
# and the Python FastAPI Backend.
#
# For Frontend only: Copy to 'react_app/.env'
# For Backend only:  Copy to 'backend/.env' (or set in Render Dashboard Environment)
# ==============================================================================

# ==============================================================================
# FRONTEND CONFIGURATION (React + Vite)
# ==============================================================================
# Client-accessible variables must begin with 'VITE_'.

# --- PayPal Sandbox (Frontend SDK) ---
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
VITE_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-here
VITE_PAYPAL_CURRENCY=USD

# --- Supabase (Frontend Auth & Realtime) ---
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Backend API Connection ---
# Local: http://localhost:8000/api/v1
# Render Production: https://trustbroker-ai-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1


# ==============================================================================
# BACKEND CONFIGURATION (Python FastAPI Service)
# ==============================================================================
# Keep these backend secrets safe. NEVER commit actual values to public repositories.

# --- Server & CORS Settings ---
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://trustbroker-ai-frontend.onrender.com

# --- Database Connection (PostgreSQL) ---
# Local: postgresql://postgres:your_password@localhost:5432/trustbroker_ai
# Supabase Production: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustbroker_ai


# --- Google Gemini AI API (Contract SOW Drafting & Evidence Verification) ---
# Obtain free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- PayPal Server-Side Credentials (Orders v2 API & Webhooks) ---
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret-here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id-here

# --- Supabase Server-Side Admin Access (Service Role) ---
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# --- Render Production Webhook (Optional for CI/CD) ---
# Obtain from: Render Dashboard -> Your Service -> Settings -> Deploy Hook
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxx?key=yyyyyy
