# ==============================================================================
# TrustBroker AI — Master Full-Stack Environment Configuration Template
# ==============================================================================
# This template lists all environment variables required across both the React Frontend
# and the Python FastAPI Backend.
#
# For Frontend: Copy variables to 'react_app/.env'
# For Backend:  Copy variables to 'backend/.env' (or configure in Render Dashboard)
# ==============================================================================

# ==============================================================================
# FRONTEND CONFIGURATION (React 19 + TypeScript + Vite)
# ==============================================================================
# Client-accessible variables must begin with 'VITE_'.

# --- PayPal Sandbox (Frontend SDK) ---
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
VITE_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-here
VITE_PAYPAL_CURRENCY=USD

# --- Supabase (Frontend Auth & Realtime) ---
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Backend API Connection ---
# Local Development: http://localhost:8000/api/v1
# Render Production: https://trustbroker-ai-api-bx9a.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- AG Studio & AG Grid Licenses (Optional) ---
# 45-day AG Studio trial: https://www.ag-grid.com/studio/react/enterprise-licence/
VITE_AG_STUDIO_LICENSE_KEY=
# VITE_AG_GRID_LICENSE_KEY=


# ==============================================================================
# BACKEND CONFIGURATION (Python FastAPI Service)
# ==============================================================================
# Keep these backend secrets secure. NEVER commit real keys to version control.

# --- Server & CORS Settings ---
PORT=8000
ENVIRONMENT=development
ALLOW_DEV_AUTH_TOKENS=false
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://trustbroker-ai-frontend-bx9a.onrender.com

# --- Database Connection (PostgreSQL) ---
# Local: postgresql://postgres:postgres@localhost:5432/trustbroker_ai
# Supabase Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustbroker_ai

# --- Supabase Server-Side Admin Access (Service Role) ---
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# --- PayPal Server-Side Credentials (Orders v2 API & Payouts) ---
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret-here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id-here

# --- AI Providers (Groq LPU -> OpenRouter -> DeepSeek Fallback) ---
# 1. Groq LPU (Primary — High-Speed LPU Inference, Free Tier): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Secondary Free Fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-4-27b-it:free

# 3. DeepSeek Official Platform API (Tier 3 Robust Fallback): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- Render Production Webhook (Optional for CI/CD) ---
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxx?key=yyyyyy
