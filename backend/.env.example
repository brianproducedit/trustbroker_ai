# ==============================================================================
# TrustBroker AI — Backend Service Environment Variables (.env)
# ==============================================================================

# --- Server & CORS Settings ---
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://trustbroker-ai-frontend.onrender.com

# --- Database Connection (PostgreSQL) ---
# Local: postgresql://postgres:your_password@localhost:5432/trustbroker_ai
# Supabase Production: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustbroker_ai


# --- Supabase Admin & Auth Integration ---
# URL from: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://fgdvlrfbpzkaetwwjhxq.supabase.co
# Service Role Key (secret, bypasses RLS for admin and backend tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# JWT Secret from: Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# --- PayPal Orders v2 Sandbox Integration ---
PAYPAL_CLIENT_ID=BAAmI_hm2hcLqXaEfmcdS2nqtnkLq1lbmEiObYFaZ6uSbZqvn3uMVeHPVtoTJAheKH8ZCR1duXTaypmcLY
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret-here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --- AI Providers (Groq → OpenRouter → Deterministic Fallback) ---
# 1. Groq (Primary — Fast LPU Inference, Generous Free Tier): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Secondary Free Fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-4-27b-it:free

