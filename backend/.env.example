# ==============================================================================
# TrustBroker AI — Backend Service Environment Configuration Template (.env)
# ==============================================================================
# Copy this file to '.env' inside the 'backend/' directory:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secret keys or credentials to public Git repositories.
# ==============================================================================

# --- Server & CORS Settings ---
PORT=8000
ENVIRONMENT=development
# Set to 'true' ONLY for offline local testing; strictly rejected when ENVIRONMENT=production
ALLOW_DEV_AUTH_TOKENS=false
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed CORS origins for FastAPI middleware
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://trustbroker-ai-frontend-bx9a.onrender.com

# --- Database Connection (PostgreSQL) ---
# Local: postgresql://postgres:postgres@localhost:5432/trustbroker_ai
# Production (Supabase): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustbroker_ai

# --- Supabase Admin & Authentication ---
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-supabase-project.supabase.co
# Service Role Key (bypasses RLS for secure backend admin tasks & user management)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# JWT Secret for validating Supabase auth tokens (Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# --- PayPal Integration (Orders v2 & Payouts API) ---
# Obtain sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret-here
# Mode: 'sandbox' or 'live'
PAYPAL_MODE=sandbox
# Webhook ID: optional for development, required for live webhook signature verification
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id-here

# --- AI Providers (Multi-tiered Fallback Engine) ---
# 1. Groq LPU (Primary — High-Speed LPU Inference, Free Tier): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Secondary Free Fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-4-27b-it:free

# 3. DeepSeek Official Platform API (Tier 3 Robust Fallback): https://platform.deepseek.com/api_keys
# Direct OpenAI-compatible endpoint with automatic server-side prefix caching
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# --- Optional Cloud CI/CD ---
# Render Deploy Hook URL for triggering auto-deployments
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxx?key=yyyyyy
